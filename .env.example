DB_USERNAME=cobweb
DB_PASSWORD=
JWT_SECRET=

MAIL_USERNAME=
MAIL_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 개발 전용 PostgreSQL 18 (compose.dev.yaml, 5433 포트). 기존 MySQL 볼륨은 재사용하지 않습니다.
DEV_DB_PASSWORD=
DEV_ADMIN_PASSWORD=
# 운영 도메인 및 PostgreSQL 관리자 비밀번호 (compose.prod.yaml)
SITE_DOMAIN=
PUBLIC_BASE_URL=http://localhost:8080
POSTGRES_ADMIN_PASSWORD=
# 전용 채점 호스트용 (compose.worker.yaml). 웹 앱과 같은 DB에 닿는 사설 TLS 엔드포인트를 지정합니다.
WORKER_DB_URL=
WORKER_DB_USERNAME=
WORKER_DB_PASSWORD=
# 일반 로컬 실행에서는 기존 DB 보호를 위해 마이그레이션/채점을 기본 비활성화합니다.
FLYWAY_ENABLED=false
JUDGE_ENABLED=false
# 워커 호스트에서 먼저 docker build -t cobweb-languages:local judge 실행
JUDGE_IMAGE=cobweb-languages:local

# OpenAI 서버 연결 준비 전용. 현재 실제 호출/웹 API는 없고 true로 바꿔도 외부 통신하지 않습니다.
# 실제 키는 서버 환경변수/secret manager로만 공급하세요. VITE_*·프런트 소스에 넣지 마세요.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_ALLOWED_MODELS=
OPENAI_MAX_INPUT_CHARACTERS=8000
OPENAI_MAX_OUTPUT_TOKENS=512
OPENAI_TIMEOUT_MS=5000
