DB_USERNAME=cobweb
DB_PASSWORD=
JWT_SECRET=

MAIL_USERNAME=
MAIL_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 개발 전용 PostgreSQL 18 (compose.dev.yaml, 5433 포트). 기존 MySQL 볼륨은 재사용하지 않습니다.
DEV_DB_PASSWORD=
DEV_ADMIN_PASSWORD=
# 운영 도메인 및 PostgreSQL 관리자 비밀번호 (compose.prod.yaml)
SITE_DOMAIN=cobweb.kr
# 직접 실행하는 Spring 설정. 운영 Compose는 SITE_DOMAIN으로 공개 주소를 구성합니다.
# run.sh는 아래 값을 파일에서 읽지 않고 명시 셸 환경을 사용합니다.
# 예: COBWEB_PUBLIC_BASE_URL=https://login.example.com ./run.sh (PUBLIC_BASE_URL 환경도 지원)
PUBLIC_BASE_URL=https://localhost:8443
POSTGRES_ADMIN_PASSWORD=
# 전용 채점 호스트용 (compose.worker.yaml). 웹 앱과 같은 DB에 닿는 사설 TLS 엔드포인트를 지정합니다.
WORKER_DB_URL=
WORKER_DB_USERNAME=
WORKER_DB_PASSWORD=
# 일반 로컬 실행에서는 기존 DB 보호를 위해 마이그레이션/채점을 기본 비활성화합니다.
FLYWAY_ENABLED=false
JUDGE_ENABLED=false
# 워커 호스트에서 먼저 docker build -t cobweb-languages:local judge 실행
JUDGE_IMAGE=cobweb-languages:local

# 내 활동 → AI 리포트 (기본 꺼짐). 키는 서버 환경변수로만 공급합니다.
# 리포트는 Responses API의 reasoning.effort=none을 사용합니다.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_ALLOWED_MODELS=gpt-6-luna
OPENAI_MAX_INPUT_CHARACTERS=8000
OPENAI_MAX_OUTPUT_TOKENS=512
OPENAI_TIMEOUT_MS=10000
